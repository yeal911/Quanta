<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================== -->
    <!-- 语义颜色 Token — 亮色主题                                     -->
    <!-- 所有界面 XAML 通过 {DynamicResource Key} 引用，切换主题自动刷新 -->
    <!-- ========================================================== -->

    <!-- 背景 -->
    <SolidColorBrush x:Key="WindowBackground"           Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HoverBackground"            Color="#F0F0F0"/>
    <SolidColorBrush x:Key="MenuItemSelectedBackground" Color="#E3F2FD"/>
    <SolidColorBrush x:Key="ListItemSelectedBackground" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ListItemHoverBackground"    Color="#F0F0F0"/>
    <SolidColorBrush x:Key="AltRowBackground"           Color="#F8F8F8"/>
    <SolidColorBrush x:Key="RowSelectedBackground"      Color="#E67E22"/>
    <SolidColorBrush x:Key="RowHoverBackground"         Color="#F0F6FF"/>

    <!-- 前景（文字）-->
    <SolidColorBrush x:Key="PrimaryText"                Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SecondaryText"              Color="#666666"/>
    <SolidColorBrush x:Key="TertiaryText"               Color="#AAAAAA"/>
    <SolidColorBrush x:Key="SectionHeaderText"          Color="#333333"/>
    <SolidColorBrush x:Key="MenuItemSelectedForeground" Color="#1976D2"/>
    <SolidColorBrush x:Key="DataGridHeaderText"         Color="#888888"/>
    <SolidColorBrush x:Key="RowSelectedForeground"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RowNumberText"              Color="#999999"/>

    <!-- 边框 -->
    <SolidColorBrush x:Key="WindowBorder"               Color="#E0E0E0"/>
    <SolidColorBrush x:Key="InputBorder"                Color="#DDDDDD"/>
    <SolidColorBrush x:Key="SeparatorBorder"            Color="#EEEEEE"/>
    <SolidColorBrush x:Key="DataGridHeaderBorder"       Color="#E8E8E8"/>
    <SolidColorBrush x:Key="GroupHeaderBorder"          Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ScrollBarThumbBackground"    Color="#20000000"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBackground" Color="#40000000"/>
    <SolidColorBrush x:Key="ScrollBarThumbPressedBackground" Color="#60000000"/>
    <SolidColorBrush x:Key="ScrollBarTrackBackground"    Color="#10000000"/>

    <!-- 强调色（文字）：亮色沿用原值 -->
    <SolidColorBrush x:Key="AccentBlueText"           Color="#0078D4"/>
    <SolidColorBrush x:Key="AccentLightBlueText"      Color="#3498DB"/>
    <SolidColorBrush x:Key="AccentGreenText"          Color="#27AE60"/>
    <SolidColorBrush x:Key="AccentOrangeText"         Color="#E67E22"/>
    <SolidColorBrush x:Key="AccentPurpleText"         Color="#8E44AD"/>
    <SolidColorBrush x:Key="AccentRedText"            Color="#E74C3C"/>

    <!-- 强调色（实心按钮背景，前景白色，两套主题一致） -->
    <SolidColorBrush x:Key="AccentBlueButton"         Color="#0078D4"/>
    <SolidColorBrush x:Key="AccentGreenButton"        Color="#27AE60"/>
    <SolidColorBrush x:Key="AccentOrangeButton"       Color="#E67E22"/>
    <SolidColorBrush x:Key="AccentPurpleButton"       Color="#8E44AD"/>
    <SolidColorBrush x:Key="AccentRedButton"          Color="#E74C3C"/>

    <!-- 录制配置芯片背景（亮色下用低饱和浅色底） -->
    <SolidColorBrush x:Key="ChipBlueBackground"       Color="#E8F4FF"/>
    <SolidColorBrush x:Key="ChipGreenBackground"      Color="#F0F8E8"/>
    <SolidColorBrush x:Key="ChipPurpleBackground"     Color="#F8E8FF"/>

    <!-- 录音悬浮窗（HUD）：悬浮于任意屏幕内容之上，深浅主题刻意保持一致的半透明深色 -->
    <SolidColorBrush x:Key="OverlayLoadingBackground"    Color="#CC666666"/>
    <SolidColorBrush x:Key="OverlayPanelBackground"      Color="#88707070"/>
    <SolidColorBrush x:Key="OverlayPanelInnerBackground" Color="#55252525"/>
    <SolidColorBrush x:Key="OverlayText"                 Color="#F5F5F5"/>

    <!-- ========================================================== -->
    <!-- 隐式控件样式 — 同类控件自动应用，无需在每个控件上单独设置       -->
    <!-- ========================================================== -->

    <!-- TextBox：修复暗色主题下输入框文字保持黑色的根本原因 -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground"     Value="{StaticResource PrimaryText}"/>
        <Setter Property="CaretBrush"     Value="{StaticResource PrimaryText}"/>
        <Setter Property="Background"     Value="Transparent"/>
        <Setter Property="BorderBrush"    Value="{StaticResource InputBorder}"/>
        <Setter Property="SelectionBrush" Value="#4D0078D4"/>
    </Style>

    <!-- ComboBox（折叠状态）-->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground"  Value="{StaticResource PrimaryText}"/>
        <Setter Property="Background"  Value="{StaticResource WindowBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
    </Style>

    <!-- ComboBoxItem（下拉条目）-->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground"  Value="{StaticResource PrimaryText}"/>
        <Setter Property="Background"  Value="{StaticResource WindowBackground}"/>
    </Style>

    <!-- CheckBox -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
    </Style>

</ResourceDictionary>
